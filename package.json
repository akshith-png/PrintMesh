{
    "version": "0.1.0",
    "name": "printmesh",
    "description": "Real-time local printing network",
    "scripts": {
        "test": "vitest run",
        "build": "npm --workspace apps/web run build",
        "check": "npm --workspace apps/web run lint && npm --workspace apps/web run typecheck",
        "dev": "npm --workspace apps/web run dev",
        "agent": "dotnet run --project services/print-agent/PrintMesh.Agent"
        ,"audit:production": "npm audit --omit=dev --audit-level=high"
    },
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "private": true,
    "devDependencies": {
        "vitest": "^5.0.3"
    }
}
